    "הַיְלָדָה אוֹכֶלֶת תַּפּוּחַ וּבָנָנָה. עַל הַשֻּׁלְחָן יֵשׁ לֶחֶם וְחָלָב.": {
      "url": "/audio/e9573c634b364fcb8ed9.mp3",
      "text": "הַיְלָדָה אוֹכֶלֶת תַּפּוּחַ וּבָנָנָה. עַל הַשֻּׁלְחָן יֵשׁ לֶחֶם וְחָלָב."
    },
    "הַקְשִׁיבוּ הֵיטֵב, וּבִחֲרוּ אֶת הַתְּשׁוּבָה.": {
      "url": "/audio/e7ffaa90cac93f631fac.mp3",
      "text": "הַקְשִׁיבוּ הֵיטֵב, וּבִחֲרוּ אֶת הַתְּשׁוּבָה."
    },
    "הַקְשִׁיבוּ לַמִּלָּה, וְגְּעוּ בַּתְּמוּנָה הַמַּתְאִימָה.": {
      "url": "/audio/cda1c68ab74c3c2e9ce7.mp3",
      "text": "הַקְשִׁיבוּ לַמִּלָּה, וְגְּעוּ בַּתְּמוּנָה הַמַּתְאִימָה."
    },
    "הַקְשִׁיבוּ לַסִּפּוּר, וּבִחֲרוּ אֶת הַתְּמוּנָה הַמַּתְאִימָה.": {
      "url": "/audio/854df97cca2defa70459.mp3",
      "text": "הַקְשִׁיבוּ לַסִּפּוּר, וּבִחֲרוּ אֶת הַתְּמוּנָה הַמַּתְאִימָה."
